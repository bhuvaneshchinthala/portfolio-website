---
import { Head } from "@/components/Head";
import AppRouter from "@/components/Router";
import GlobalBackground from "@/components/GlobalBackground";
import MagneticCursor from "@/components/ui/MagneticCursor";
import LenisWrapper from "@/components/LenisWrapper";
import "@/styles/global.css";

export function getStaticPaths() {
  return [
    { params: { slug: undefined } },
    { params: { slug: 'about-me' } },
    { params: { slug: 'pdf-viewer' } },
    { params: { slug: 'stabondar' } },
    { params: { slug: 'cbum' } },
    { params: { slug: 'system' } },
    { params: { slug: 'chat' } },
  ];
}

const currentPath = Astro.url.pathname;
const isCbumPage = currentPath.includes('/cbum');
---

<html lang="en" class="w-full h-full">
  <head>
    <Head />
  </head>
  <body class="w-full h-full antialiased">
    <div id="root" class="w-full h-full relative cursor-none">
      <LenisWrapper client:only="react">
        {!isCbumPage && <MagneticCursor client:only="react" />}
        {/* <GlobalBackground client:only="react" /> */}
        <AppRouter client:only="react" />
      </LenisWrapper>
    </div>
  </body>
</html>
