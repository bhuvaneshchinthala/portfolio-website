{
  "extends": "astro/tsconfigs/base",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "@/integrations": [
        "integrations/index"
      ],
      "@/integrations/*": [
        "integrations/*"
      ]
    }
  }
}